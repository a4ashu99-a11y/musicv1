local allSongs = HttpService:JSONDecode(RawSongData)

-- ==========================================
-- 5. FANCY UI BUILDER & ANIMATIONS
-- ==========================================
local function CreateFancyBtn(parent, text, defaultCol, callback)
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = defaultCol, Text = "  " .. text, TextColor3 = Color3.fromRGB(240, 240, 240), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 2}, parent)
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)
    
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(math.clamp(defaultCol.R*255+20,0,255), math.clamp(defaultCol.G*255+20,0,255), math.clamp(defaultCol.B*255+20,0,255))}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = defaultCol}):Play() end)
    btn.MouseButton1Down:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {TextSize = 11}):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {TextSize = 13}):Play() end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- ==========================================
-- 6. SEARCH ENGINE LOGIC
-- ==========================================
local SearchLayout = Create("Frame", {Size = UDim2.new(1, -20, 1, -20), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1}, TabSearch)
local SBox = Create("TextBox", {Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 0), PlaceholderText = " Type here to search 1,000+ songs...", Text = "", Font = Enum.Font.Gotham, TextSize = 14, BackgroundColor3 = Color3.fromRGB(25, 25, 25), TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 2}, SearchLayout)
Create("UICorner", {CornerRadius = UDim.new(0, 6)}, SBox)
Create("UIStroke", {Color = Color3.fromRGB(88, 101, 242), Thickness = 1}, SBox)
Create("UIPadding", {PaddingLeft = UDim.new(0, 10)}, SBox)

local SResults = Create("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -50), Position = UDim2.new(0, 0, 0, 50), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 2}, SearchLayout)
Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, SResults)

SBox:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(SBox.Text)
    for _, child in ipairs(SResults:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    if query == "" then return end
    
    local matchCount = 0
    for _, song in ipairs(allSongs) do
        if string.find(string.lower(song.name), query) then
            matchCount = matchCount + 1
            if matchCount > 40 then break end -- Limit to 40 to prevent any frame drops
            
            local btn = CreateFancyBtn(SResults, "▶ [" .. song.category .. "] " .. song.name, Color3.fromRGB(20, 20, 20), function()
                local parsedID = convertRGB(string.sub(tostring(song.id), 2))
                task.spawn(u9, parsedID)
                Notify("Playing Music", song.name)
            end)
            btn.Size = UDim2.new(1, -5, 0, 36)
        end
    end
end)

-- ==========================================
-- 7. LOAD 1,000+ SONGS (ASYNC BACKGROUND)
-- ==========================================
task.spawn(function()
    pcall(function()
        local pbData = game:HttpGet("https://pastebin.com/raw/nxWnza4m")
        local pbDec = HttpService:JSONDecode(pbData)
        for _, song in ipairs(pbDec) do table.insert(allSongs, song) end
    end)
    
    local SongDatabase = { Home = {}, Indian = {}, English = {}, Phonk = {} }
    for _, v in ipairs(allSongs) do
        local cat = v.category
        if SongDatabase[cat] then 
            table.insert(SongDatabase[cat], {name = v.name, id = convertRGB(string.sub(tostring(v.id), 2))})
        end
    end

    -- Build Pagination
    local function FillList(tabFrame, cat)
        local Scroll = Create("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -50), Position = UDim2.new(0, 10, 0, 45), BackgroundTransparency = 1, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 2}, tabFrame)
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, Scroll)
        
        local Top = Create("Frame", {Size = UDim2.new(1, -20, 0, 35), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, ZIndex = 2}, tabFrame)
        local pageText = Create("TextLabel", {Size = UDim2.new(1, -90, 1, 0), Position = UDim2.new(0, 45, 0, 0), BackgroundColor3 = Color3.fromRGB(20,20,20), TextColor3 = Color3.fromRGB(200,200,200), Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 2}, Top)
        Create("UICorner", {CornerRadius = UDim.new(0, 6)}, pageText)
        
        local page = 1
        local limit = 40
        
        local function Draw()
            for _, c in ipairs(Scroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
            local list = SongDatabase[cat]
            if not list then return end
            
            local maxPage = math.max(1, math.ceil(#list / limit))
            page = math.clamp(page, 1, maxPage)
            pageText.Text = "Page " .. page .. " / " .. maxPage
            
            for i = (page - 1) * limit + 1, math.min(page * limit, #list) do
                local s = list[i]
                local b = CreateFancyBtn(Scroll, "▶ " .. s.name, Color3.fromRGB(25, 25, 25), function() task.spawn(u9, s.id) Notify("Playing Music", s.name) end)
                b.Size = UDim2.new(1, -5, 0, 36)
            end
        end
        
        local pBtn = CreateFancyBtn(Top, "<", Color3.fromRGB(35, 35, 35), function() if page > 1 then page = page - 1 Draw() end end)
        pBtn.Size = UDim2.new(0, 40, 1, 0); pBtn.TextXAlignment = Enum.TextXAlignment.Center
        
        local nBtn = CreateFancyBtn(Top, ">", Color3.fromRGB(35, 35, 35), function() if page < math.ceil(#SongDatabase[cat] / limit) then page = page + 1 Draw() end end)
        nBtn.Size = UDim2.new(0, 40, 1, 0); nBtn.Position = UDim2.new(1, -40, 0, 0); nBtn.TextXAlignment = Enum.TextXAlignment.Center

        Draw()
    end

    FillList(TabSounds, "Home")
    FillList(TabIndian, "Indian")
    FillList(TabEnglish, "English")
    FillList(TabPhonk, "Phonk")
end)
