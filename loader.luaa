-- ==========================================
-- LAG-FREE PAGINATION TABS
-- ==========================================
local SongDatabase = { Home = {}, Indian = {}, English = {}, Phonk = {} }
local ITEMS_PER_PAGE = 40

local function BuildPaginationList(tabFrame, categoryName)
    local TopCtrl = Create("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, ZIndex = 2}, tabFrame)
    local Prev = Create("TextButton", {Size = UDim2.new(0, 40, 1, 0), Text = "<", BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.GothamBold, ZIndex = 2}, TopCtrl)
    local Next = Create("TextButton", {Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(1, -40, 0, 0), Text = ">", BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.GothamBold, ZIndex = 2}, TopCtrl)
    local PageLabel = Create("TextLabel", {Size = UDim2.new(1, -90, 1, 0), Position = UDim2.new(0, 45, 0, 0), Text = "Page 1", BackgroundColor3 = Color3.fromRGB(20, 20, 20), TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.Gotham, ZIndex = 2}, TopCtrl)
    Create("UICorner", {CornerRadius = UDim.new(0, 4)}, Prev); Create("UICorner", {CornerRadius = UDim.new(0, 4)}, Next); Create("UICorner", {CornerRadius = UDim.new(0, 4)}, PageLabel)

    local ListScroll = Create("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -38), Position = UDim2.new(0, 0, 0, 38), BackgroundTransparency = 1, ScrollBarThickness = 3, ZIndex = 2}, tabFrame)
    local ListLayout = Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5)}, ListScroll)

    local CurrentPage = 1

    local function RenderPage()
        for _, child in ipairs(ListScroll:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        local list = SongDatabase[categoryName]
        if not list then return end
        local maxPage = math.ceil(#list / ITEMS_PER_PAGE)
        if maxPage < 1 then maxPage = 1 end
        if CurrentPage > maxPage then CurrentPage = maxPage end
        if CurrentPage < 1 then CurrentPage = 1 end

        PageLabel.Text = "Page " .. CurrentPage .. " / " .. maxPage

        local startIdx = (CurrentPage - 1) * ITEMS_PER_PAGE + 1
        local endIdx = math.min(startIdx + ITEMS_PER_PAGE - 1, #list)

        for i = startIdx, endIdx do
            local s = list[i]
            local b = QuickBtn(ListScroll, "▶ " .. s.name, Color3.fromRGB(25, 25, 25), function() task.spawn(u9, s.id); Notify("Playing", s.name) end)
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.Size = UDim2.new(1, 0, 0, 30)
            Create("UIPadding", {PaddingLeft = UDim.new(0, 10)}, b)
        end
        ListScroll.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
    end

    Prev.MouseButton1Click:Connect(function() if CurrentPage > 1 then CurrentPage = CurrentPage - 1 RenderPage() end end)
    Next.MouseButton1Click:Connect(function() local maxP = math.ceil(#SongDatabase[categoryName] / ITEMS_PER_PAGE) if CurrentPage < maxP then CurrentPage = CurrentPage + 1 RenderPage() end end)

    return RenderPage
end

