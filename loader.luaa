local function QuickBtn(parent, text, color, callback)
    local b = Create("TextButton", {Size = UDim2.new(1, 0, 0, 40), Text = text, Font = Enum.Font.GothamBold, TextSize = 14, BackgroundColor3 = color, TextColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 2}, parent)
    Create("UICorner", {CornerRadius = UDim.new(0, 6)}, b)
    b.MouseButton1Click:Connect(callback)
    return b
end

