-- ==========================================
-- 1. UTILITIES & RP NAME LOGIC
-- ==========================================
local function Moon(Star)
    local Cloud = {a="ᴀ",b="ʙ",c="ᴄ",d="ᴅ",e="ᴇ",f="ꜰ",g="ɢ",h="ʜ",i="ɪ",j="ᴊ",k="ᴋ",l="ʟ",m="ᴍ",n="ɴ",o="ᴏ",p="ᴘ",q="ǫ",r="ʀ",s="s",t="ᴛ",u="ᴜ",v="ᴠ",w="ᴡ",x="x",y="ʏ",z="ᴢ",A="ᴀ",B="ʙ",C="ᴄ",D="ᴅ",E="ᴇ",F="ꜰ",G="ɢ",H="ʜ",I="ɪ",J="ᴊ",K="ᴋ",L="ʟ",M="ᴍ",N="ɴ",O="ᴏ",P="ᴘ",Q="ǫ",R="ʀ",S="s",T="ᴛ",U="ᴜ",V="ᴠ",W="ᴡ",X="x",Y="ʏ",Z="ᴢ"}
    local Sky = ""
    for Wind = 1, #Star do Sky = Sky .. (Cloud[Star:sub(Wind, Wind)] or Star:sub(Wind, Wind)) end
    return Sky
end

local function convertRGB(value)
    local RGBcolour = { ["0"]="9", ["1"]="0", ["2"]="1", ["3"]="2", ["4"]="3", ["5"]="4", ["6"]="5", ["7"]="6", ["8"]="7", ["9"]="8" }
    local result = {}
    for i = 1, #value do result[i] = RGBcolour[value:sub(i, i)] or value:sub(i, i) end
    return table.concat(result)
end

