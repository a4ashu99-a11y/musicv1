-- ==========================================
-- LAG-FREE VOLUME HACK (0% CPU) & SENDER
-- ==========================================
local MAX_VOLUME = 10 
local function applyVolumeHack(sound)
    if sound:IsA("Sound") then
        sound.Volume = MAX_VOLUME
        if not sound:FindFirstChild("CoreHubAmplifier") then
            local equalizer = Instance.new("EqualizerSoundEffect")
            equalizer.Name = "CoreHubAmplifier"
            equalizer.HighGain, equalizer.MidGain, equalizer.LowGain = 10, 10, 10
            equalizer.Parent = sound
        end
    end
end

local function scanAndHook(parentObj)
    for _, obj in ipairs(parentObj:GetDescendants()) do applyVolumeHack(obj) end
    parentObj.DescendantAdded:Connect(applyVolumeHack)
end

if player.Character then scanAndHook(player.Character) end
player.CharacterAdded:Connect(scanAndHook)

local vehiclesFolder = workspace:WaitForChild("Vehicles", 10)
if vehiclesFolder then
    vehiclesFolder.ChildAdded:Connect(function(vehicle)
        task.wait(1.5) 
        if vehicle.Name:lower():find(player.Name:lower(), 1, true) then scanAndHook(vehicle) end
    end)
    for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
        if vehicle.Name:lower():find(player.Name:lower(), 1, true) then scanAndHook(vehicle) end
    end
end

local function u9(songId)
    local RE = game:GetService("ReplicatedStorage"):WaitForChild("RE")
    local t1 = { RE["1Player1sHous1e"], RE["1Player1sCa1r"], RE["1NoMoto1rVehicle1s"], RE.PlayerToolEvent, RE.Props, RE["1Hors1eRemot1e"] }
    local t2 = { "PickHouseMusicText", "Music", "PickingScooterMusicText", "ToolMusicText", "PropMusicText", "HorseMusicText" }

    for k, v in pairs(t1) do pcall(function() v:FireServer(t2[k], "0", true) end) task.wait(0.03) end
    task.wait(0.1)
    for k, v in pairs(t1) do pcall(function() v:FireServer(t2[k], tostring(songId), true) end) task.wait(0.03) end
end

