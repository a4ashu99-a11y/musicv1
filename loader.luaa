local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
ScreenGui.Name = "CoreHub_ExclusiveUI"
ScreenGui.ResetOnSpawn = false

local function Create(className, properties, parent)
    local obj = Instance.new(className)
    for k, v in pairs(properties) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

-- Notification System
local NotifContainer = Create("Frame", {Size = UDim2.new(0, 250, 1, -50), Position = UDim2.new(1, -260, 0, 25), BackgroundTransparency = 1, ZIndex = 100}, ScreenGui)
Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Bottom}, NotifContainer)

local function Notify(title, text)
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BackgroundTransparency = 0.1}, NotifContainer)
    Create("UICorner", {CornerRadius = UDim.new(0, 8)}, frame)
    Create("UIStroke", {Color = Color3.fromRGB(88, 101, 242), Thickness = 1}, frame)
    Create("TextLabel", {Size = UDim2.new(1, -10, 0, 20), Position = UDim2.new(0, 10, 0, 5), Text = title, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.fromRGB(255,255,255), TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1}, frame)
    Create("TextLabel", {Size = UDim2.new(1, -10, 0, 30), Position = UDim2.new(0, 10, 0, 25), Text = text, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(200,200,200), TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, TextWrapped = true}, frame)
    task.delay(3, function() frame:Destroy() end)
end

